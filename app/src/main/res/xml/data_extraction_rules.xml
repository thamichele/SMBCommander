<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" stops cloud backups but not device-to-device transfers. Nothing is copied: the
     password only decrypts with a Keystore key that stays on this phone anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
